--- /dev/null
+++ b/pexpert/pexpert/arm64/DODGE.h
@@ -0,0 +1,80 @@
+/*
+ * pexpert/arm64/DODGE.h — OnePlus 13 (dodge, Qualcomm SM8750 / Oryon-v2) board
+ * configuration for a from-source XNU bring-up (xnu-8796.141.3, iOS 16 era).
+ *
+ * This is our own file. It is modeled on Apple's open-source board headers
+ * BCM2837.h (NO_MONITOR plain-pmap non-Apple board) and VMAPPLE.h (GICv3 + 16K,
+ * both under the Apple Public Source License). The overall "add a non-Apple
+ * board config that reuses XNU's built-in GICv3 + open pmap" approach is the
+ * method demonstrated by dipa-studio/ios-sweet (iOS 16 on SM7150) — credit to
+ * them; no code was copied from their (unlicensed) repo.
+ *
+ * Hardware values are from the OnePlus 13 live device tree (work/sm8750/sm8750.dts)
+ * and iomem: GICv3 dist 0x16000000 / redist 0x16080000 (stride 0x40000); ARM
+ * architected timer 19.2 MHz; virtual timer = PPI 11 = INTID 27.
+ *
+ * Bring-up stance: plain arm64 (NOT arm64e). Oryon implements PAC, but we build
+ * without pointer-auth first to keep the port simple (same choice ios-sweet made
+ * for its A76/A55). PAC can be added later as a separate step.
+ */
+#ifndef _PEXPERT_ARM64_DODGE_H
+#define _PEXPERT_ARM64_DODGE_H
+
+#define NO_MONITOR                1   /* no PPL/SPTM: plain in-kernel pmap */
+#define NO_ECORE                  1   /* bring-up: treat all cores uniformly */
+
+#define DODGE                     1
+#define ARM_ARCH_TIMER                /* generic architected timer, not Apple's */
+#define HAS_GIC_V3                1   /* SM8750 is GICv3 (arm,gic-v3) */
+
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_16K_PG__            1   /* Oryon supports the 16K translation granule */
+#define __ARM_PAN_AVAILABLE__     1
+#define __ARM64_PMAP_SUBPAGE_L1__ 1   /* as BCM2837; revisit once VM is up */
+
+/* No CPU_HAS_APPLE_PAC / HAS_PARAVIRTUALIZED_PAC: we build plain arm64 for now. */
+
+#ifndef ASSEMBLER
+
+/* Console goes to the framebuffer the bootloader leaves us (set via the ADT /
+ * boot-args); no Apple SoC UART here. A persistent log ring comes later. */
+#define PLATFORM_PANIC_LOG_DISABLED
+
+/*
+ * GICv3 register definitions (architectural — identical to VMAPPLE.h, from the
+ * GICv3 spec, Arm IHI 0069). The distributor/redistributor BASE addresses are
+ * supplied at runtime from the device tree; only the offsets/strides live here.
+ */
+#define GIC_SPURIOUS_IRQ          1023
+
+/* SM8750 redistributor stride is 0x40000 (device tree redistributor-stride). */
+#define GICR_PE_SIZE              0x40000
+
+#define GICD_CTLR                 0x0
+#define GICD_CTLR_ENABLEGRP0      0x1
+
+#define GICR_TYPER                0x08
+#define GICR_WAKER                0x14
+#define GICR_IGROUPR0             0x10080
+#define GICR_ISENABLER0           0x10100
+
+#define GICR_TYPER_AFFINITY_VALUE_SHIFT  32
+#define GICR_TYPER_LAST                  0x10
+
+#define GICR_WAKER_PROCESSORSLEEP        0x2
+#define GICR_WAKER_CHILDRENASLEEP        0x4
+
+#define ICC_CTLR_EOIMODE          0x1
+#define ICC_SRE_SRE               0x1
+
+/* Virtual timer PPI on SM8750 = PPI 11 = INTID 27 (also provided via the ADT
+ * "virtual-timer-intid" property for the pe_fiq GICv3 path). */
+#define DODGE_VTIMER_INTID        27
+
+#endif /* ! ASSEMBLER */
+
+#endif /* ! _PEXPERT_ARM64_DODGE_H */
